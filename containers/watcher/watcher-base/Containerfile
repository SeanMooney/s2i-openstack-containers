ARG BASE_IMAGE=localhost/openstack/openstack-base:latest

# --- Build stage: compile wheels from source ---
FROM ${BASE_IMAGE} AS build

ARG SERVICE_SRC=/src/watcher

ARG CONSTRAINTS_FILE=requirements.lock
ARG SOURCE_PACKAGE_MAP=watcher-base/source-package-map.txt
COPY ${CONSTRAINTS_FILE} /deps-upper-constraints.txt
COPY ${SOURCE_PACKAGE_MAP} /tmp/source-package-map.txt
COPY src/ /src/
COPY watcher-base/src/ /src/

# We can force build from source of all packages optionally
ARG PIP_NO_BINARY=""
ENV PIP_NO_BINARY=${PIP_NO_BINARY}
# required to build rpds-py from source
ENV MATURIN_NO_INSTALL_RUST=true

COPY watcher-base/builddeps.txt /tmp/builddeps.txt
RUN pkgs=$(cat /tmp/builddeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs} && microdnf clean all; fi

COPY watcher-base/pythonbuilddeps.txt /tmp/pythonbuilddeps.txt
RUN pkgs=$(cat /tmp/pythonbuilddeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then pip3 install --no-cache-dir -c /deps-upper-constraints.txt ${pkgs}; fi && \
    rm /tmp/pythonbuilddeps.txt

RUN cp /deps-upper-constraints.txt /tmp/build-constraints.txt && \
    for src_dir in /src/overrides/*/; do \
      [ -d "${src_dir}" ] || continue; \
      [ -f "${src_dir}/setup.cfg" ] || continue; \
      pkg_name=$(grep -m1 '^name' "${src_dir}/setup.cfg" | sed 's/.*=\s*//'); \
      sed -i "/^${pkg_name}[=!<>]/Id" /tmp/build-constraints.txt; \
    done

# First build the wheels fro the packages themselves
RUN for pkg in /src/*/ /src/overrides/*/; do \
      if [ -d "${pkg}" ] && [ -f "${pkg}/setup.cfg" -o -f "${pkg}/setup.py" -o -f "${pkg}/pyproject.toml" ]; then \
        pip3 wheel --no-cache-dir --no-deps \
          --wheel-dir=/wheels/pkgs "${pkg}"; \
      fi; \
    done

# Second, build the wheels for the dependencies and place them in a different directory
RUN pip3 wheel --no-cache-dir --no-deps \
          --find-links=/wheels/pkgs \
          --wheel-dir=/wheels/deps -r /deps-upper-constraints.txt

RUN set -eu; \
    : > /source-built-packages.txt; \
    record_package() { \
      source_path="$1"; distribution="$2"; src_dir="/src/${source_path}"; \
      [ -d "${src_dir}" ] || { echo "Missing mapped source: ${source_path}" >&2; return 1; }; \
      commit=$(git -C "${src_dir}" rev-parse HEAD) || return 1; \
      wheel_prefix=${distribution//-/_}; \
      set -- /wheels/pkgs/${wheel_prefix}-*.whl; \
      [ "$#" -eq 1 ] && [ -f "$1" ] || { echo "Missing or ambiguous wheel: ${distribution}" >&2; return 1; }; \
      wheel=$(basename "$1" .whl); version=${wheel#${wheel_prefix}-}; version=${version%%-*}; \
      [ -n "${version}" ] || { echo "Missing wheel version: ${distribution}" >&2; return 1; }; \
      echo "${distribution},${commit},${version}" >> /source-built-packages.txt; \
    }; \
    while read -r source_path distribution extra; do \
      [ -z "${extra:-}" ] || { echo "Malformed source package map" >&2; exit 1; }; \
      [ -z "${source_path:-}" ] || record_package "${source_path}" "${distribution}"; \
    done < /tmp/source-package-map.txt; \
    for src_dir in /src/overrides/*/; do \
      [ -d "${src_dir}" ] || continue; source_name=$(basename "${src_dir}"); \
      grep -q "^overrides/${source_name} " /tmp/source-package-map.txt && continue; \
      [ -f "${src_dir}/setup.cfg" ] || continue; \
      distribution=$(grep -m1 '^name' "${src_dir}/setup.cfg" | sed 's/.*=\s*//'); \
      record_package "overrides/${source_name}" "${distribution}"; \
    done

# Install wheels temporarily so entry points are available for config generation
RUN pip3 install --no-cache-dir --prefix=/usr \
      -c /tmp/build-constraints.txt \
      --find-links=/wheels/deps \
      --find-links=/wheels/pkgs \
      /wheels/pkgs/*.whl

# Generate sample config using oslo-config-generator
RUN mkdir -p /configfiles/etc/watcher && \
    oslo-config-generator \
      --config-file ${SERVICE_SRC}/etc/watcher/oslo-config-generator/watcher.conf \
      --output-file /configfiles/etc/watcher/watcher.conf && \
    sed -i "/#pybasedir.*/d" /configfiles/etc/watcher/watcher.conf

# --- Runtime stage ---
FROM ${BASE_IMAGE}

LABEL summary="OpenStack Watcher services" \
      io.k8s.description="Consolidated Watcher API, applier, and decision-engine image built from source with the Kolla interface"

RUN uid_gid_manage watcher

COPY watcher-base/bindeps.txt /tmp/bindeps.txt
RUN pkgs=$(cat /tmp/bindeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs} && microdnf clean all; fi && \
    rm /tmp/bindeps.txt

COPY --from=build /wheels /wheels
COPY --from=build /tmp/build-constraints.txt /deps-upper-constraints.txt
COPY --from=build /source-built-packages.txt /source-built-packages.txt
COPY watcher-base/pythondeps.txt /tmp/pythondeps.txt
RUN extrapkgs=$(cat /tmp/pythondeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    pip3 install --no-cache-dir --prefix=/usr \
      -c /deps-upper-constraints.txt \
      --find-links=/wheels/deps \
      --find-links=/wheels/pkgs \
      /wheels/pkgs/*.whl ${extrapkgs} && \
    rm -rf /wheels /tmp/pythondeps.txt

RUN mkdir -p /etc/watcher /var/log/watcher /var/lib/watcher /var/cache/watcher && \
    chown -R watcher:watcher /etc/watcher /var/log/watcher /var/lib/watcher /var/cache/watcher

# Install generated config file
COPY --from=build /configfiles/etc/watcher/watcher.conf /etc/watcher/watcher.conf

RUN chmod 640 /etc/watcher/watcher.conf && \
    chown watcher:watcher /etc/watcher/watcher.conf

# Apache httpd setup for the API process in the consolidated image
RUN sed -i -r 's,^(Listen 80),#\1,' /etc/httpd/conf/httpd.conf && \
    sed -i -r 's,^(Listen 443),#\1,' /etc/httpd/conf.d/ssl.conf 2>/dev/null || true && \
    usermod --append --groups apache watcher

USER watcher
